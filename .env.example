# Backend server
APP_HOST=127.0.0.1
APP_PORT=8000

# Comma-separated list of origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
# console is human-readable. json writes one JSON object per line.
LOG_FORMAT=console
# Optional JSONL file. Leave false unless you want a local analysis log.
LOG_FILE_ENABLED=false
LOG_FILE_PATH=backend/data/logs/app.jsonl

# Instrumentation output (model-call metrics JSONL)
METRICS_OUTPUT_DIR=backend/data/metrics

# Evaluation output (JSONL + CSV results)
EVAL_OUTPUT_DIR=backend/data/evals

# Provider credentials are read from the process environment only.
# Keep these placeholders empty in repository files.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
GROQ_API_KEY=
GROQ_MODEL=
GROQ_BASE_URL=https://api.groq.com/openai/v1
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
